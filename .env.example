# Public customer website URL used by shareable QR codes.
# Set this to the deployed HTTPS origin (for example https://food.example.com).
VITE_PUBLIC_APP_URL=

# Optional browser-restricted Google Maps Embed API key.
# Restrict this key by allowed website referrers and the Maps Embed API.
VITE_GOOGLE_MAPS_EMBED_KEY=

# Public API origin. Never put server secrets in VITE_* variables.
VITE_API_BASE_URL=http://localhost:4000

# Server-only API configuration
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Optional local fallback path; production carts and orders use PostgreSQL.
DATABASE_PATH=./data/viggy-mart.sqlite
DATABASE_URL=
# Use the rotated Neon pooled connection string here, never in source control or VITE_* variables.
JWT_SECRET=replace-with-at-least-32-random-characters
DELIVERY_INVITE_CODE=
# Cloudflare Turnstile; configure both values together. The site key is safe to expose
# through the API, but the secret key must stay server-side.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
